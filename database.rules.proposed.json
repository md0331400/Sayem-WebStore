{
  "_comment": "PROPOSED — do not deploy until Firebase Auth migration is complete, every trusted admin is mapped outside the client-writable database, and legacy login reads are retired. Public app reads remain intentional. Guest download counter writes target only apps/$key/downloads.",
  "rules": {
    "apps": {
      ".read": true,
      "$key": {
        ".write": "auth != null && root.child('adminUids').child(auth.uid).exists()",
        "downloads": {
          ".write": true,
          ".validate": "newData.isNumber() && (data.exists() ? data.isNumber() && newData.val() === data.val() + 1 : newData.val() === 1)",
          "_comment": "Guest download increments are limited to exactly +1; clients cannot arbitrarily overwrite the counter."
        },
        "reviews": {
          "$reviewId": {
            "_comment": "Post-migration: review.userId holds the Firebase Auth uid.",
            ".write": "auth != null && (root.child('adminUids').child(auth.uid).exists() || newData.child('userId').val() === auth.uid || data.child('userId').val() === auth.uid)"
          }
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).exists()"
    },
    "ads": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).exists()"
    },
    "adStats": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).exists()"
    },
    "users": {
      "$recordKey": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('adminUids').child(auth.uid).exists())",
        ".write": "auth != null && (data.child('uid').val() === auth.uid || newData.child('uid').val() === auth.uid || root.child('adminUids').child(auth.uid).exists())",
        ".validate": "root.child('adminUids').child(auth.uid).exists() || (newData.child('uid').val() === auth.uid && (!data.exists() || (newData.child('blocked').val() === data.child('blocked').val() && newData.child('status').val() === data.child('status').val())))",
        ".indexOn": [
          "uid",
          "email",
          "number"
        ]
      }
    },
    "reports": {
      ".read": "auth != null && root.child('adminUids').child(auth.uid).exists()",
      "$key": {
        ".write": "auth != null && (root.child('adminUids').child(auth.uid).exists() || newData.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['subject','message','userId','timestamp']) && newData.child('subject').isString() && newData.child('subject').val().length <= 200 && newData.child('message').isString() && newData.child('message').val().length <= 5000 && newData.child('userId').isString() && newData.child('timestamp').isNumber()"
      }
    },
    "visitors": {
      ".read": "auth != null && root.child('adminUids').child(auth.uid).exists()",
      "$token": {
        ".write": false
      }
    },
    "adminActivity": {
      ".read": "auth != null && root.child('adminUids').child(auth.uid).exists()",
      "$key": {
        ".write": "auth != null && root.child('adminUids').child(auth.uid).exists()"
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    "adminUids": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
